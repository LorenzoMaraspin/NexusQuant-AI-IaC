{
  "Comment": "NexusQuant offline backtest grid. Start execution with {\"key\": \"backtest-configs/<file>.json\"} (grid read straight from S3: a JSON list of configs) or with {\"configs\": [ {...} ], \"run_group_id\": \"<uuid, optional>\"}. One ECS Fargate task per config; MaxConcurrency protects Bedrock quotas and RDS connections.",
  "StartAt": "Start",
  "States": {
    "Start": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.configs",
          "IsPresent": true,
          "Next": "ResolveRunGroup"
        },
        {
          "Variable": "$.key",
          "IsPresent": true,
          "Next": "LoadGrid"
        }
      ],
      "Default": "NoGridProvided"
    },
    "NoGridProvided": {
      "Type": "Fail",
      "Error": "NoGridProvided",
      "Cause": "Input must be {\"key\": \"backtest-configs/<file>.json\"} (S3 object in the data bucket) or {\"configs\": [ ... ]}."
    },
    "LoadGrid": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Parameters": {
        "Bucket": "${grid_bucket}",
        "Key.$": "$.key"
      },
      "ResultSelector": {
        "body.$": "$.Body"
      },
      "ResultPath": "$.file",
      "Next": "ParseGrid"
    },
    "ParseGrid": {
      "Type": "Pass",
      "Parameters": {
        "grid.$": "States.StringToJson($.file.body)"
      },
      "Next": "WrappedOrList"
    },
    "WrappedOrList": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.grid.configs",
          "IsPresent": true,
          "Next": "UnwrapConfigs"
        }
      ],
      "Default": "ListConfigs"
    },
    "UnwrapConfigs": {
      "Type": "Pass",
      "Parameters": {
        "configs.$": "$.grid.configs"
      },
      "Next": "GenerateRunGroup"
    },
    "ListConfigs": {
      "Type": "Pass",
      "Parameters": {
        "configs.$": "$.grid"
      },
      "Next": "GenerateRunGroup"
    },
    "ResolveRunGroup": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.run_group_id",
          "IsPresent": true,
          "Next": "CollectNames"
        }
      ],
      "Default": "GenerateRunGroup"
    },
    "GenerateRunGroup": {
      "Type": "Pass",
      "Parameters": {
        "run_group_id.$": "States.UUID()",
        "configs.$": "$.configs"
      },
      "Next": "CollectNames"
    },
    "CollectNames": {
      "Type": "Pass",
      "Parameters": {
        "run_group_id.$": "$.run_group_id",
        "configs.$": "$.configs",
        "names.$": "$.configs[*].name"
      },
      "Next": "CountNames"
    },
    "CountNames": {
      "Type": "Pass",
      "Parameters": {
        "run_group_id.$": "$.run_group_id",
        "configs.$": "$.configs",
        "total.$": "States.ArrayLength($.configs)",
        "named.$": "States.ArrayLength($.names)",
        "unique.$": "States.ArrayLength(States.ArrayUnique($.names))"
      },
      "Next": "NamesValid"
    },
    "NamesValid": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.named",
              "NumericEqualsPath": "$.total"
            },
            {
              "Variable": "$.unique",
              "NumericEqualsPath": "$.total"
            }
          ],
          "Next": "RunBacktests"
        }
      ],
      "Default": "InvalidGrid"
    },
    "InvalidGrid": {
      "Type": "Fail",
      "Error": "InvalidGrid",
      "Cause": "Every config needs a non-empty, unique 'name' (retries are idempotent on run_group_id + name)."
    },
    "RunBacktests": {
      "Type": "Map",
      "ItemsPath": "$.configs",
      "MaxConcurrency": ${max_concurrency},
      "ItemSelector": {
        "run_group_id.$": "$.run_group_id",
        "index.$": "$$.Map.Item.Index",
        "config.$": "$$.Map.Item.Value"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "RunWithRetry",
        "States": {
          "RunWithRetry": {
            "Type": "Parallel",
            "Branches": [
              {
                "StartAt": "RunBacktestTask",
                "States": {
                  "RunBacktestTask": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::ecs:runTask.sync",
                    "TimeoutSeconds": ${task_timeout_seconds},
                    "Parameters": {
                      "Cluster": "${cluster_arn}",
                      "TaskDefinition": "${task_definition_arn}",
                      "CapacityProviderStrategy": [
                        {
                          "CapacityProvider": "${capacity_provider}",
                          "Weight": 1
                        }
                      ],
                      "NetworkConfiguration": {
                        "AwsvpcConfiguration": {
                          "Subnets": ${jsonencode(subnet_ids)},
                          "SecurityGroups": ${jsonencode(security_group_ids)},
                          "AssignPublicIp": "DISABLED"
                        }
                      },
                      "Group.$": "States.Format('backtest-{}', $.run_group_id)",
                      "Overrides": {
                        "ContainerOverrides": [
                          {
                            "Name": "${container_name}",
                            "Environment": [
                              {
                                "Name": "BACKTEST_CONFIG_JSON",
                                "Value.$": "States.JsonToString($.config)"
                              },
                              {
                                "Name": "BACKTEST_RUN_GROUP_ID",
                                "Value.$": "$.run_group_id"
                              }
                            ]
                          }
                        ]
                      }
                    },
                    "ResultSelector": {
                      "taskArn.$": "$.TaskArn",
                      "exitCodes.$": "$.Containers[*].ExitCode"
                    },
                    "ResultPath": "$.task",
                    "Next": "CheckExitCode"
                  },
                  "CheckExitCode": {
                    "Type": "Pass",
                    "Parameters": {
                      "taskArn.$": "$.task.taskArn",
                      "ok.$": "States.ArrayContains($.task.exitCodes, 0)"
                    },
                    "Next": "ExitCodeOk"
                  },
                  "ExitCodeOk": {
                    "Type": "Choice",
                    "Choices": [
                      {
                        "Variable": "$.ok",
                        "BooleanEquals": true,
                        "Next": "BranchSucceeded"
                      }
                    ],
                    "Default": "BacktestTaskFailed"
                  },
                  "BranchSucceeded": {
                    "Type": "Pass",
                    "End": true
                  },
                  "BacktestTaskFailed": {
                    "Type": "Fail",
                    "Error": "BacktestTaskFailed",
                    "Cause": "The backtest container exited with a non-zero exit code or never ran (Spot interruption, image pull or startup failure)."
                  }
                }
              }
            ],
            "ResultSelector": {
              "taskArn.$": "$[0].taskArn"
            },
            "ResultPath": "$.task",
            "Retry": [
              {
                "ErrorEquals": [
                  "BacktestTaskFailed",
                  "States.TaskFailed",
                  "ECS.AmazonECSException",
                  "ECS.ServerException",
                  "AmazonECS.Unknown"
                ],
                "IntervalSeconds": 30,
                "BackoffRate": 2,
                "MaxAttempts": ${retry_attempts}
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "MarkFailed"
              }
            ],
            "Next": "MarkSucceeded"
          },
          "MarkSucceeded": {
            "Type": "Pass",
            "Parameters": {
              "status": "SUCCEEDED",
              "index.$": "$.index",
              "taskArn.$": "$.task.taskArn"
            },
            "End": true
          },
          "MarkFailed": {
            "Type": "Pass",
            "Parameters": {
              "status": "FAILED",
              "index.$": "$.index",
              "error.$": "$.error.Error"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.results",
      "Next": "SummarizeResults"
    },
    "SummarizeResults": {
      "Type": "Pass",
      "Parameters": {
        "run_group_id.$": "$.run_group_id",
        "results.$": "$.results",
        "statuses.$": "$.results[*].status"
      },
      "Next": "EvaluateResults"
    },
    "EvaluateResults": {
      "Type": "Pass",
      "Parameters": {
        "run_group_id.$": "$.run_group_id",
        "results.$": "$.results",
        "hasFailures.$": "States.ArrayContains($.statuses, 'FAILED')"
      },
      "Next": "AnyFailures"
    },
    "AnyFailures": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.hasFailures",
          "BooleanEquals": true,
          "Next": "SomeBacktestsFailed"
        }
      ],
      "Default": "AllSucceeded"
    },
    "SomeBacktestsFailed": {
      "Type": "Fail",
      "Error": "BacktestsFailed",
      "Cause": "One or more backtest configs failed after retries. Check the RunBacktests state output: items with status FAILED carry the grid index."
    },
    "AllSucceeded": {
      "Type": "Succeed"
    }
  }
}
