# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data,
# except for example and template files
*.tfvars
*.tfvars.json
environments/*.tfvars
!*.tfvars.example
!environments/*.example.tfvars

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include fake override files for testing
!fake_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore generated key files
*.pem
*.key
*.env

# Terraform plan files (can embed full state, including secrets, in cleartext)
terraformplan
tfplan
*.tfplan
plan
*.plan
